# Example environment configuration for the backend
## Exemple de configuration d'environnement pour le backend

# --- Configuration MySQL ---
MYSQL_USER=your_user
MYSQL_PASSWORD=your_password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=your_db

# --- Configuration JWT (authentification) ---
SECRET_KEY=your_jwt_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
TOKEN_CLEANUP_INTERVAL_HOURS=24

# --- Configuration GitHub ---
GITHUB_TOKEN=your_github_token
CONNECT_TIMEOUT=10
READ_TIMEOUT=60
ACTIONS_MAX_RUNS=100
DEPLOYMENTS_MAX_ITEMS=30