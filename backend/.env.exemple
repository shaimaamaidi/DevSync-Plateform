# Example environment configuration for the backend
## Exemple de configuration d'environnement pour le backend

# --- Configuration MySQL ---
MYSQL_USER=your_user
MYSQL_PASSWORD=your_password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=your_db

# --- Configuration JWT (authentification) ---
JWT_SECRET_KEY=your_jwt_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
TOKEN_CLEANUP_INTERVAL_HOURS=24

# --- Configuration GitHub token ---
GITHUB_TOKEN=your_github_token
CONNECT_TIMEOUT=10
READ_TIMEOUT=60
ACTIONS_MAX_RUNS=100
DEPLOYMENTS_MAX_ITEMS=30

# --- Configuration Bing Search ---
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com
BING_SEARCH_API_KEY=your_bing_api_key
BING_CONNECTION_NAME=your_bing_connection_name

# --- Configuration Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://your-azure-openai-endpoint/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=your_deployment_name

# --- Configuration Projet Azure ---
AZURE_PROJECT_ENDPOINT=https://your-azure-project-endpoint
AZURE_PROJECT_NAME=your_project_name
AZURE_SUBSCRIPTION_ID=your_subscription_id
AZURE_RESOURCE_GROUP_NAME=your_resource_group
AZURE_TENANT_ID=your_tenant_id
AZURE_CLIENT_ID=your_client_id
AZURE_CLIENT_SECRET=your_client_secret

# --- Agents ---
TASK_CREATOR_AGENT_ID=your_task_creator_agent_id
TASK_CREATOR_WEB_SEARCH_AGENT_ID=your_web_search_agent_id

# --- Recherche Web ---
WEB_SEARCH_MAX_RETRIES=3
WEB_SEARCH_RETRY_BASE_DELAY=2
WEB_SEARCH_RETRY_MAX_DELAY=30
WEB_SEARCH_RUN_TIMEOUT=60